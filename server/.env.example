# ---------------------------------------------------------------------------
# NexHub ECS 服务端配置（复制为 .env 后按需修改）
# 注意：.env 含敏感信息，切勿提交到 Git。
# ---------------------------------------------------------------------------
NEXHUB_HOST=0.0.0.0
NEXHUB_PORT=8000
NEXHUB_DEVICE_ONLINE_SECONDS=75

# 数据目录与 SQLite 文件（留空使用 server/data）
# NEXHUB_DATA_DIR=
# NEXHUB_DB_PATH=
# 上传临时文件与本地 OSS 回退目录（默认跟随数据目录）
# NEXHUB_UPLOAD_TMP_DIR=
# NEXHUB_LOCAL_OSS_DIR=
# 头像本地存储（不经过 OSS，默认 data/avatars）
# NEXHUB_AVATAR_DIR=

# 首次初始化管理员（数据库已有用户后不再生效）
NEXHUB_ADMIN_USERNAME=admin
NEXHUB_ADMIN_PASSWORD=ChangeMe@12345
NEXHUB_DEMO_PASSWORD=demo1234

# API Token 与 Cookie
NEXHUB_SECRET_KEY=please-change-this-to-a-long-random-secret
NEXHUB_TOKEN_TTL_HOURS=168
NEXHUB_COOKIE_SECURE=false

# 网页访问域名（用于生成 /s/<token> 分享链接，可留空）
NEXHUB_WEB_BASE=https://share.example.com

# 客户端注册默认自动审核通过；设为 0 后新账号进入待审核列表
# 首次初始化后也可在管理后台「系统设置」中切换
NEXHUB_REGISTRATION_AUTO_APPROVE=1

# 管理后台「服务端检查更新」使用的更新源
# 默认 GitHub Releases；fork 或使用镜像时改成对应 API / latest.json 地址
NEXHUB_UPDATE_FEED=https://api.github.com/repos/mouchenguo/NexHub/releases

# OSS（仅保存在 ECS，不返回客户端）
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=nexhub/shares

# 全局 OSS 配额与规则
NEXHUB_OSS_QUOTA_GB=50
NEXHUB_MAX_OSS_BYTES=5368709120

# nps 内网穿透
NPS_SERVER_ADDR=
NPS_SERVER_PORT=8024
NPS_VKEY=
NPS_API_URL=
# NPS Web API 鉴权密钥（对应 /etc/nps/conf/nps.conf 的 auth_key，仅服务端使用）
NPS_AUTH_KEY=
NPS_DOMAIN=
# 临时共享自动创建的 TCP 公网端口范围
NPS_TUNNEL_PORT_START=30000
NPS_TUNNEL_PORT_END=30100
# 1=发布临时共享时自动创建 NPS TCP 任务，取消时删除
NPS_AUTO_TUNNEL=1
